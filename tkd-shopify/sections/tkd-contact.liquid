{% comment %}
  TKD Contact — página de contato: título grande + linhas de canal
  (e-mail, redes) em cards clicáveis (design system v2).
{% endcomment %}

<div class="tkd-contact tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w900">
    <div class="reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tkd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h1 class="tkd-contact__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="tkd-contact__sub">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="tkd-contact__rows">
      {%- for block in section.blocks -%}
        {%- liquid
          assign href = block.settings.url
          if block.type == 'email'
            assign href = 'mailto:' | append: block.settings.value
          endif
        -%}
        <a
          class="tkd-contact__row reveal"
          style="transition-delay: {{ forloop.index0 | times: 60 }}ms;"
          href="{{ href }}"
          {% if block.type == 'link' and block.settings.external %}target="_blank" rel="noopener"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="label">{{ block.settings.label | escape }}</span>
          <span>{{ block.settings.value | escape }}</span>
          <span class="arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M7 17L17 7m0 0H8m9 0v9"/></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Contact",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Let's talk"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Dúvidas, colabs ou suporte — chama em qualquer canal abaixo."
    }
  ],
  "blocks": [
    {
      "type": "email",
      "name": "E-mail",
      "settings": [
        { "type": "text", "id": "label", "label": "Rótulo", "default": "E-mail" },
        { "type": "text", "id": "value", "label": "Endereço", "default": "prodbytkd@gmail.com" }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Rótulo", "default": "Instagram" },
        { "type": "text", "id": "value", "label": "Texto exibido", "default": "@tkdprod" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "checkbox", "id": "external", "label": "Abrir em nova aba", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "TKD Contact",
      "blocks": [
        { "type": "email" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
