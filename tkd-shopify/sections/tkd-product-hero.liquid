{% comment %}
  TKD Product Hero — janela INFO.TXT (portado do HERO/PRODUCT de pack.$id.tsx).
  Vinil giratório, título, tagline, preço + compare-at + carimbo, botão de
  compra pelo product form NATIVO da Shopify (AJAX + cart drawer via
  product-form.js do Refresh) e preview master do player TKD.
{% endcomment %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign accent = product.metafields.tkd.accent_color.value | default: '#e6a635'
  assign tagline = product.metafields.tkd.tagline.value
  assign formats = product.metafields.tkd.formats.value
  assign previews = product.metafields.tkd.preview_files.value

  assign psize = 0
  if previews
    assign psize = previews.size
  endif

  assign midx = product.metafields.tkd.master_preview_index.value | default: 0 | at_least: 0
  if midx >= psize
    assign midx = 0
  endif

  assign master_url = ''
  if psize > 0
    assign master_file = previews[midx]
    assign master_url = master_file.url
  endif

  assign back_url = section.settings.back_link
  if back_url == blank
    if product.collections.size > 0
      assign back_url = product.collections.first.url
    else
      assign back_url = routes.all_products_collection_url
    endif
  endif

  assign cover_small = ''
  if product.featured_image
    assign cover_small = product.featured_image | image_url: width: 144
  endif
-%}

<div class="tkd-product-hero tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w1300">
    <a href="{{ back_url }}" class="tkd-backlink">&lt; {{ section.settings.back_label | escape }}</a>

    <div class="win tkd-product-hero__win reveal">
      <div class="win-title">
        <span>C:\ARCHIVE\{{ product.handle | upcase | replace: '-', '_' }}\INFO.TXT</span>
        <span class="win-controls"><span>_</span><span>&#9633;</span><span>&times;</span></span>
      </div>

      <div class="tkd-product-hero__grid">
        {%- # Capa em vinil — gira enquanto qualquer faixa deste pack toca -%}
        <div class="tkd-product-hero__art">
          <div
            class="tkd-vinyl"
            data-tkd-vinyl
            data-track-prefix="{{ product.id }}-"
            style="
              {%- if product.featured_image -%}
                background: center / cover no-repeat url('{{ product.featured_image | image_url: width: 880 }}');
              {%- else -%}
                background: radial-gradient(circle at 30% 30%, {{ accent }}66, #0a0704 72%);
              {%- endif -%}
              --tkd-vinyl-accent: {{ accent }}66;
            "
            role="img"
            aria-label="{{ product.featured_image.alt | default: product.title | escape }}"
          >
            {%- unless product.featured_image -%}
              <div class="tkd-vinyl__name">{{ product.title | escape }}</div>
            {%- endunless -%}
            <div class="tkd-vinyl__hole" aria-hidden="true"></div>
          </div>
        </div>

        {%- # Detalhes -%}
        <div class="tkd-product-hero__details">
          {%- if formats != blank -%}
            <div class="tkd-product-hero__formats">&gt; {{ formats }}</div>
          {%- endif -%}

          <h1 class="tkd-product-hero__title chroma">{{ product.title | escape }}</h1>

          {%- if tagline != blank -%}
            <p class="tkd-product-hero__tagline">&gt; {{ tagline }}</p>
          {%- endif -%}

          <div class="tkd-price-row font-tkd-pixel">
            <span class="tkd-price-row__price">{{ product.price | money_without_trailing_zeros }}</span>
            {%- if product.compare_at_price > product.price -%}
              <span class="tkd-price-row__was">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
            {%- endif -%}
            {%- if section.settings.stamp_text != blank -%}
              <span class="stamp stamp-olive">{{ section.settings.stamp_text | escape }}</span>
            {%- endif -%}
          </div>

          <div class="tkd-product-hero__actions">
            <product-form data-section-id="{{ section.id }}" data-hide-errors="false">
              {%- form 'product', product, id: 'tkd-product-form-hero', class: 'tkd-product-form', novalidate: 'novalidate' -%}
                {%- if product.variants.size > 1 -%}
                  <select name="id" class="tkd-variant-select" aria-label="{{ 'products.product.product_variants' | t }}">
                    {%- for variant in product.variants -%}
                      <option
                        value="{{ variant.id }}"
                        {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{ variant.title | escape }} — {{ variant.price | money_without_trailing_zeros }}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {%- endif -%}

                <button
                  type="submit"
                  name="add"
                  class="tkd-btn tkd-btn-solid tkd-buy-btn"
                  {% unless product.available %}disabled aria-disabled="true"{% endunless %}
                >
                  <span>
                    {%- if product.available -%}
                      {{ section.settings.buy_label | escape }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                  {%- render 'loading-spinner' -%}
                </button>

                <div class="product-form__error-message-wrapper tkd-form-error" role="alert" hidden>
                  <span class="product-form__error-message"></span>
                </div>
              {%- endform -%}
            </product-form>

            {%- if psize > 1 -%}
              <a href="#preview" class="tkd-btn tkd-btn-outline">♪ {{ section.settings.previews_label | escape }}</a>
            {%- endif -%}
          </div>

          {%- if master_url != blank -%}
            <div class="tkd-master-preview-wrap">
              <div class="audio-row tkd-master-preview" data-tkd-row>
                <button
                  type="button"
                  class="audio-play-btn tkd-master-preview__btn"
                  data-tkd-play
                  data-track-id="{{ product.id }}-{{ midx }}"
                  data-track-src="{{ master_url }}"
                  data-track-name="PREVIEW"
                  data-pack-name="{{ product.title | escape }}"
                  data-pack-url="{{ product.url }}"
                  data-accent="{{ accent }}"
                  {% if cover_small != blank %}data-cover="{{ cover_small }}"{% endif %}
                  aria-label="Play preview"
                >
                  <svg class="tkd-icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="tkd-icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
                </button>
                <div class="tkd-master-preview__label font-tkd-pixel">Preview</div>
                <div class="tkd-master-preview__wave">
                  <div class="waveform waveform--hero" data-tkd-waveform data-for="{{ product.id }}-{{ midx }}" data-bars="48" data-seek="playing"></div>
                </div>
                <span class="tkd-master-preview__time font-tkd-pixel" data-tkd-time data-for="{{ product.id }}-{{ midx }}" data-mode="both" hidden></span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.trust_text != blank -%}
            <div class="tkd-trust-line">{{ section.settings.trust_text | escape }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Produto — Hero",
  "tag": "section",
  "class": "section-tkd-product-hero",
  "settings": [
    {
      "type": "text",
      "id": "back_label",
      "label": "Texto do link de volta",
      "default": "back to archive"
    },
    {
      "type": "url",
      "id": "back_link",
      "label": "Link de volta",
      "info": "Se vazio, usa a primeira coleção do produto."
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Texto do botão de compra",
      "info": "O botão adiciona ao carrinho nativo da Shopify (abre o cart drawer).",
      "default": "▶ Buy Here"
    },
    {
      "type": "text",
      "id": "previews_label",
      "label": "Texto do botão de previews",
      "default": "More Previews"
    },
    {
      "type": "text",
      "id": "stamp_text",
      "label": "Carimbo ao lado do preço",
      "default": "Royalty-Free for Sales"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Linha de confiança",
      "default": "[ SECURE CHECKOUT · CARD & PAYPAL · INSTANT DELIVERY · CLEARED FOR COMMERCIAL USE ]"
    }
  ]
}
{% endschema %}
