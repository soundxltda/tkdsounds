{% comment %}
  TKD Product Hero — topo da página de produto (design system v2).
  Capa quadrada arredondada à esquerda; formatos, título, tagline,
  preço, form nativo (checkout Shopify) e master preview à direita.
  Player: contrato data-* de assets/tkd-player.js.
{% endcomment %}

{%- liquid
  assign previews = product.metafields.tkd.preview_files.value
  assign titles = product.metafields.tkd.preview_titles.value
  assign formats = product.metafields.tkd.formats.value
  assign tagline = product.metafields.tkd.tagline.value

  assign psize = 0
  if previews
    assign psize = previews.size
  endif

  assign midx = product.metafields.tkd.master_preview_index.value | default: 0 | at_least: 0
  if midx >= psize
    assign midx = 0
  endif

  assign master_url = ''
  if psize > 0
    assign master_file = previews[midx]
    assign master_url = master_file.url
  endif

  assign badge_text = ''
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down == 'bestseller'
      assign badge_text = 'Bestseller'
      break
    elsif tag_down == 'new' or tag_down == 'novo'
      assign badge_text = 'New'
    endif
  endfor
-%}

<div class="tkd-product-hero tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w1300">
    {%- if section.settings.show_breadcrumb -%}
      <a href="{{ section.settings.breadcrumb_link | default: routes.all_products_collection_url }}" class="tkd-backlink">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M19 12H5m0 0l6-6m-6 6l6 6"/></svg>
        {{ section.settings.breadcrumb_label | escape }}
      </a>
    {%- endif -%}

    <div class="tkd-product-hero__grid">
      <div class="tkd-product-hero__art reveal">
        {%- if badge_text != blank -%}
          <span class="tkd-product-hero__badge tkd-badge">{{ badge_text }}</span>
        {%- endif -%}
        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 1000 }}"
            srcset="{{ product.featured_image | image_url: width: 500 }} 500w, {{ product.featured_image | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 990px) 45vw, 100vw"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            loading="eager"
          >
        {%- else -%}
          <div class="pack-card__fallback"><span>{{ product.title | escape }}</span></div>
        {%- endif -%}
      </div>

      <div class="tkd-product-hero__details">
        {%- if formats != blank -%}
          <div class="tkd-product-hero__formats reveal">{{ formats | escape }}</div>
        {%- endif -%}

        <h1 class="tkd-product-hero__title reveal">{{ product.title | escape }}</h1>

        {%- if tagline != blank -%}
          <p class="tkd-product-hero__tagline reveal">{{ tagline | escape }}</p>
        {%- endif -%}

        <div class="tkd-price-row reveal">
          <span class="tkd-price-row__price">{{ product.price | money_without_trailing_zeros }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="tkd-price-row__was">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
          {%- endif -%}
          {%- if section.settings.stamp_text != blank -%}
            <span class="stamp">{{ section.settings.stamp_text | escape }}</span>
          {%- endif -%}
        </div>

        <div class="tkd-product-hero__actions reveal">
          <product-form data-section-id="{{ section.id }}" data-hide-errors="false">
            {%- form 'product', product, id: 'tkd-product-form-hero', class: 'tkd-product-form', novalidate: 'novalidate' -%}
              {%- if product.variants.size > 1 -%}
                <select name="id" class="tkd-variant-select" aria-label="{{ 'products.product.product_variants' | t }}">
                  {%- for variant in product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title | escape }} — {{ variant.price | money_without_trailing_zeros }}
                    </option>
                  {%- endfor -%}
                </select>
              {%- else -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              {%- endif -%}

              <button
                type="submit"
                name="add"
                class="tkd-btn tkd-btn-solid tkd-buy-btn"
                {% unless product.available %}disabled aria-disabled="true"{% endunless %}
              >
                <span>
                  {%- if product.available -%}
                    {{ section.settings.buy_label | escape }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                {%- render 'loading-spinner' -%}
              </button>

              <div class="product-form__error-message-wrapper tkd-form-error" role="alert" hidden>
                <span class="product-form__error-message"></span>
              </div>
            {%- endform -%}
          </product-form>

          {%- if psize > 1 -%}
            <a href="#preview" class="tkd-btn tkd-btn-outline">{{ section.settings.previews_label | escape }}</a>
          {%- endif -%}
        </div>

        {%- if master_url != blank -%}
          <div class="tkd-master-preview-wrap reveal">
            <div class="audio-row tkd-master-preview" data-tkd-row>
              <button
                type="button"
                class="audio-play-btn tkd-master-preview__btn"
                data-tkd-play
                data-track-id="{{ product.id }}-{{ midx }}"
                data-track-src="{{ master_url }}"
                data-track-name="PREVIEW"
                data-pack-name="{{ product.title | escape }}"
                data-pack-url="{{ product.url }}"
                {% if product.featured_image %}data-cover="{{ product.featured_image | image_url: width: 120 }}"{% endif %}
                aria-label="Play preview"
              >
                <svg class="tkd-icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                <svg class="tkd-icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
              </button>
              <span class="tkd-master-preview__label">Preview</span>
              <div class="tkd-master-preview__wave">
                <div class="waveform waveform--hero" data-tkd-waveform data-for="{{ product.id }}-{{ midx }}" data-bars="48" data-seek="playing"></div>
              </div>
              <span class="tkd-master-preview__time" data-tkd-time data-for="{{ product.id }}-{{ midx }}" data-mode="both" hidden></span>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.trust_text != blank -%}
          <p class="tkd-trust-line reveal">{{ section.settings.trust_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Product Hero",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Mostrar link de voltar",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Texto do link de voltar",
      "default": "Back to packs"
    },
    {
      "type": "url",
      "id": "breadcrumb_link",
      "label": "Link de voltar",
      "info": "Se vazio, aponta para todos os produtos."
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Texto do botão de compra",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "previews_label",
      "label": "Texto do botão de previews",
      "default": "Listen to previews"
    },
    {
      "type": "text",
      "id": "stamp_text",
      "label": "Selo ao lado do preço (vazio = oculto)",
      "default": "Royalty-free"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Linha de confiança",
      "default": "Instant download · Secure checkout · Royalty-free license"
    }
  ]
}
{% endschema %}
