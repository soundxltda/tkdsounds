    responsive: true,
  });

  // ÁUDIO
  wavesurfer.load(
    "https://cdn.shopify.com/s/files/1/0768/7166/3890/files/toronto_144_bm_tkdprod.mp3?v=1763944469"
  );

  // Botão PLAY/PAUSE
  const button = document.getElementById("playPause0");

  button.addEventListener("click", function () {
    wavesurfer.playPause();
    button.classList.toggle("fa-play", !wavesurfer.isPlaying());
    button.classList.toggle("fa-pause", wavesurfer.isPlaying());
  });

  // Volta para "play" quando termina
  wavesurfer.on("finish", () => {
    button.classList.remove("fa-pause");
    button.classList.add("fa-play");
  });
});
