{% comment %}
  TKD Footer — rodapé (design system v2). Wordmark grande, links de
  blocks (link/email/menu de políticas) e linha legal.
{% endcomment %}

<footer class="tkd-footer">
  <div class="tkd-footer__inner">
    <div class="tkd-footer__top">
      <div>
        <div class="tkd-footer__brand">
          {{ section.settings.brand_text | escape }}<span class="brand-dim">.</span>
        </div>
        {%- if section.settings.tagline != blank -%}
          <p class="tkd-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
      </div>

      <div class="tkd-footer__links">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link' -%}
              <a
                href="{{ block.settings.url }}"
                {% if block.settings.external %}target="_blank" rel="noopener"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | escape -}}
              </a>
            {%- when 'email' -%}
              <a href="mailto:{{ block.settings.email }}" {{ block.shopify_attributes }}>
                {{- block.settings.label | default: block.settings.email | escape -}}
              </a>
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.menu != blank -%}
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="tkd-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | escape }}</span>
      {%- if section.settings.status_text != blank -%}
        <span>{{ section.settings.status_text | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "TKD Footer",
  "tag": "div",
  "class": "section-tkd-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Wordmark",
      "default": "TKD Sounds"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Royalty-free sample packs and sound kits, straight from TKD's studio."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de links (políticas etc.)"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Texto de copyright",
      "default": "TKD Sounds · All rights reserved"
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Texto à direita (vazio = oculto)",
      "default": "WAV · 24-bit · Royalty-free"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Instagram" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "checkbox", "id": "external", "label": "Abrir em nova aba", "default": true }
      ]
    },
    {
      "type": "email",
      "name": "E-mail",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto (vazio = mostra o e-mail)" },
        { "type": "text", "id": "email", "label": "E-mail", "default": "prodbytkd@gmail.com" }
      ]
    }
  ]
}
{% endschema %}
