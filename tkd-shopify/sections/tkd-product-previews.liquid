{% comment %}
  TKD Product Previews — painel de faixas do pack (design system v2).
  Rows de áudio com waveform; contrato data-* de assets/tkd-player.js.
{% endcomment %}

{%- liquid
  assign previews = product.metafields.tkd.preview_files.value
  assign titles = product.metafields.tkd.preview_titles.value
  assign psize = 0
  if previews
    assign psize = previews.size
  endif
-%}

{%- if psize > 0 -%}
  <div class="tkd-product-previews tkd-section" id="preview">
    <div class="tkd-section__inner tkd-section__inner--w1300">
      <div class="player-shell reveal">
        <div class="player-title-bar">
          <span class="tkd-player-title__label">
            <span class="dot" aria-hidden="true"></span>
            {{ section.settings.panel_title | escape }}
          </span>
          <span class="tkd-player-title__transport" aria-hidden="true">{{ psize }} tracks</span>
        </div>
        <div class="tkd-product-previews__list">
          {%- for preview in previews -%}
            {%- liquid
              assign i = forloop.index0
              assign track_name = 'Track ' | append: forloop.index
              if titles and titles[i] != blank
                assign track_name = titles[i]
              endif
            -%}
            <div class="audio-row" data-tkd-row>
              <button
                type="button"
                class="audio-play-btn"
                data-tkd-play
                data-track-id="{{ product.id }}-{{ i }}"
                data-track-src="{{ preview.url }}"
                data-track-name="{{ track_name | escape }}"
                data-pack-name="{{ product.title | escape }}"
                data-pack-url="{{ product.url }}"
                {% if product.featured_image %}data-cover="{{ product.featured_image | image_url: width: 120 }}"{% endif %}
                aria-label="Play — {{ track_name | escape }}"
              >
                <svg class="tkd-icon-play" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                <svg class="tkd-icon-pause" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
              </button>
              <span class="audio-row__num">{{ forloop.index | prepend: '00' | slice: -3, 3 }}</span>
              <div class="audio-row__main">
                <span class="audio-row__name truncate">{{ track_name | escape }}</span>
                <div class="audio-row__wave">
                  <div class="waveform" data-tkd-waveform data-for="{{ product.id }}-{{ i }}" data-bars="40" data-seek="playing"></div>
                </div>
              </div>
              <div class="audio-row__time" data-tkd-time data-for="{{ product.id }}-{{ i }}" data-mode="both" data-default="--:--">--:--</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "TKD Product Previews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "panel_title",
      "label": "Título do painel",
      "default": "Preview player"
    }
  ]
}
{% endschema %}
