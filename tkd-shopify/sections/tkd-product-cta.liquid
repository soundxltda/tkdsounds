{% comment %}
  TKD Product CTA — chamada final de compra da página de produto,
  com preço e form nativo (checkout Shopify), num card com glow.
{% endcomment %}

<div class="tkd-product-cta tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w1200">
    <div class="tkd-card tkd-product-cta__pad reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tkd-eyebrow tkd-product-cta__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="tkd-product-cta__title">{{ section.settings.title | escape }}</h2>

      <div class="tkd-price-row tkd-price-row--center">
        <span class="tkd-price-row__price tkd-price-row__price--lg">{{ product.price | money_without_trailing_zeros }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="tkd-price-row__was">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
        {%- endif -%}
      </div>

      <div class="tkd-product-cta__action">
        <product-form data-section-id="{{ section.id }}" data-hide-errors="false">
          {%- form 'product', product, id: 'tkd-product-form-cta', class: 'tkd-product-form tkd-product-form--center', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button
              type="submit"
              name="add"
              class="tkd-btn tkd-btn-solid tkd-buy-btn tkd-buy-btn--wide"
              {% unless product.available %}disabled aria-disabled="true"{% endunless %}
            >
              <span>
                {%- if product.available -%}
                  {{ section.settings.buy_label | escape }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
              <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
              {%- render 'loading-spinner' -%}
            </button>
            <div class="product-form__error-message-wrapper tkd-form-error" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
          {%- endform -%}
        </product-form>
      </div>

      {%- if section.settings.trust_text != blank -%}
        <p class="tkd-trust-line tkd-trust-line--center">{{ section.settings.trust_text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Product CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "Ready when you are"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Add this pack to your arsenal"
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Texto do botão",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Linha de confiança",
      "default": "Instant download · Secure checkout · Royalty-free license"
    }
  ]
}
{% endschema %}
