{% comment %}
  TKD About — "Behind the sounds": título centralizado, playlist
  (Spotify etc.) grande à esquerda e, à direita, uma coluna com a
  foto das streams + texto de bio (richtext editável no Theme Editor).
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-about {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-about {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="tkd-about tkd-section" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="tkd-section__inner tkd-section__inner--w1200">
    <div class="tkd-about__head reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tkd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="tkd-h2">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    </div>

    {%- liquid
      assign reels = section.blocks | where: 'type', 'reel'
      assign has_side = false
      if section.settings.streams_image != blank or section.settings.body != blank or reels.size > 0
        assign has_side = true
      endif
    -%}
    <div class="tkd-about__cols{% unless has_side %} tkd-about__cols--single{% endunless %}">
      {%- if section.settings.show_embed and section.settings.embed_url != blank -%}
        <div class="tkd-about__embed reveal">
          <iframe
            src="{{ section.settings.embed_url }}"
            title="{{ section.settings.embed_title | escape }}"
            height="{{ section.settings.embed_height }}"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          ></iframe>
        </div>
      {%- endif -%}

      {%- if has_side -%}
      <div class="tkd-about__side reveal">
        {%- if section.settings.body != blank -%}
          <div class="tkd-about__body">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- comment -%}
          Carrossel de reels: cada bloco é uma capa + o link do reel. Sem
          blocos cadastrados, cai na foto única de sempre — assim a section
          nunca fica vazia enquanto o TKD ainda não subiu as capas.
        {%- endcomment -%}
        {%- if reels.size > 0 -%}
          <div class="tkd-reels">
            <div class="tkd-reels__track" role="list">
              {%- for block in reels -%}
                <a
                  class="tkd-reels__item"
                  role="listitem"
                  href="{{ block.settings.url | default: section.settings.instagram_url }}"
                  target="_blank"
                  rel="noopener"
                  {{ block.shopify_attributes }}
                >
                  <span class="tkd-reels__art">
                    {%- if block.settings.cover != blank -%}
                      {{
                        block.settings.cover
                        | image_url: width: 450
                        | image_tag:
                          widths: '150,300,450',
                          sizes: '150px',
                          loading: 'lazy',
                          class: 'tkd-reels__img',
                          alt: block.settings.caption | default: 'Reel de TKD no Instagram'
                      }}
                    {%- endif -%}
                    <span class="tkd-reels__play" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                  </span>
                  {%- if block.settings.caption != blank -%}
                    <span class="tkd-reels__caption">{{ block.settings.caption | escape }}</span>
                  {%- endif -%}
                </a>
              {%- endfor -%}
            </div>
            {%- if section.settings.instagram_url != blank -%}
              <a class="tkd-reels__more" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
                {{- section.settings.instagram_label | default: 'Ver mais no Instagram' | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- elsif section.settings.streams_image != blank -%}
          <img
            class="tkd-about__streams"
            src="{{ section.settings.streams_image | image_url: width: 480 }}"
            srcset="{{ section.settings.streams_image | image_url: width: 280 }} 280w, {{ section.settings.streams_image | image_url: width: 480 }} 480w"
            sizes="220px"
            width="{{ section.settings.streams_image.width }}"
            height="{{ section.settings.streams_image.height }}"
            alt="{{ section.settings.streams_image.alt | default: 'Streams' }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD About",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Âncora (id p/ links #)",
      "default": "about"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "About"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Behind the sounds"
    },
    {
      "type": "header",
      "content": "Playlist / embed"
    },
    {
      "type": "checkbox",
      "id": "show_embed",
      "label": "Mostrar embed",
      "default": true
    },
    {
      "type": "text",
      "id": "embed_url",
      "label": "URL do embed"
    },
    {
      "type": "text",
      "id": "embed_title",
      "label": "Título acessível do embed",
      "default": "Playlist"
    },
    {
      "type": "range",
      "id": "embed_height",
      "label": "Altura do embed",
      "min": 80,
      "max": 480,
      "step": 8,
      "default": 416,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Coluna da direita"
    },
    {
      "type": "image_picker",
      "id": "streams_image",
      "label": "Foto (usada só se não houver reels)",
      "info": "Assim que você adicionar o primeiro reel abaixo, o carrossel entra no lugar desta foto."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto sobre você"
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Retrato (não usado neste layout)"
    },
    {
      "type": "header",
      "content": "Carrossel de reels",
      "info": "Use \"Adicionar reel\" no fim do painel. Cada reel = uma capa (print do vídeo, em pé) + o link do reel."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Link do perfil",
      "info": "Aparece como \"ver mais\" embaixo do carrossel."
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Texto do \"ver mais\"",
      "default": "Ver mais no Instagram"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 96,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Capa do reel",
          "info": "Print do vídeo, em pé (9:16). É o que aparece no card."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link do reel",
          "info": "Abre o reel no Instagram ao clicar."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Legenda curta (opcional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "TKD About" }]
}
{% endschema %}
