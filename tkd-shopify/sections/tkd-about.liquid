{% comment %}
  TKD About — retrato + bio + playlist embed (design system v2).
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-about {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-about {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="tkd-about tkd-section" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="tkd-section__inner tkd-section__inner--w1200">
    <div class="tkd-about__grid">
      {%- if section.settings.portrait != blank -%}
        <div class="tkd-about__portrait-wrap reveal">
          <img
            class="tkd-about__portrait"
            src="{{ section.settings.portrait | image_url: width: 900 }}"
            srcset="{{ section.settings.portrait | image_url: width: 480 }} 480w, {{ section.settings.portrait | image_url: width: 900 }} 900w"
            sizes="(min-width: 990px) 40vw, 100vw"
            width="{{ section.settings.portrait.width }}"
            height="{{ section.settings.portrait.height }}"
            alt="{{ section.settings.portrait.alt | default: section.settings.title | escape }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div>
        <div class="reveal">
          {%- if section.settings.eyebrow != blank -%}
            <span class="tkd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="tkd-h2">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
        </div>

        <div class="tkd-about__body reveal" style="margin-top: 24px;">
          {{ section.settings.body }}
        </div>

        {%- if section.settings.show_embed and section.settings.embed_url != blank -%}
          <div class="tkd-about__embed reveal">
            <iframe
              src="{{ section.settings.embed_url }}"
              title="{{ section.settings.embed_title | escape }}"
              height="{{ section.settings.embed_height }}"
              loading="lazy"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            ></iframe>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD About",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Âncora (id p/ links #)",
      "default": "about"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "About"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Behind the sounds"
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Retrato"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Bio"
    },
    {
      "type": "header",
      "content": "Embed (Spotify etc.)"
    },
    {
      "type": "checkbox",
      "id": "show_embed",
      "label": "Mostrar embed",
      "default": true
    },
    {
      "type": "text",
      "id": "embed_url",
      "label": "URL do embed"
    },
    {
      "type": "text",
      "id": "embed_title",
      "label": "Título acessível do embed",
      "default": "Playlist"
    },
    {
      "type": "range",
      "id": "embed_height",
      "label": "Altura do embed",
      "min": 80,
      "max": 480,
      "step": 8,
      "default": 352,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 96,
      "unit": "px"
    }
  ],
  "presets": [{ "name": "TKD About" }]
}
{% endschema %}
