{% comment %}
  TKD FAQ — perguntas frequentes em accordion (details/summary),
  ícone "+" rotaciona ao abrir (design system v2).
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-faq {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-faq {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="tkd-faq tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w900">
    <div class="reveal" style="text-align: center;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tkd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="tkd-h2">{{ section.settings.title | escape }}</h2>
    </div>

    <div class="tkd-faq__list">
      {%- for block in section.blocks -%}
        <details class="tkd-faq__item reveal" style="transition-delay: {{ forloop.index0 | times: 50 }}ms;" {{ block.shopify_attributes }}>
          <summary class="tkd-faq__q">
            <span>{{ block.settings.question | escape }}</span>
            <span class="tkd-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="tkd-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Questions, answered"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pergunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pergunta",
          "default": "Os packs são royalty-free?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Resposta",
          "default": "<p>Sim — todos os sons podem ser usados em lançamentos comerciais sem custos extras.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TKD FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "Em quais DAWs funciona?", "answer": "<p>Todos os arquivos são WAV 24-bit e funcionam em qualquer DAW: FL Studio, Ableton, Logic, Reaper e mais.</p>" } },
        { "type": "faq", "settings": { "question": "Como recebo o download?", "answer": "<p>Depois da compra você recebe o link de download por e-mail, na hora.</p>" } }
      ]
    }
  ]
}
{% endschema %}
