{% comment %}
  TKD Credibility — prova social: texto de credibilidade + embed
  (Spotify etc.) num card horizontal (design system v2).
{% endcomment %}

<div class="tkd-credibility tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w1300">
    <div class="tkd-card tkd-credibility__card reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="tkd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <p class="tkd-credibility__text">{{ section.settings.text | escape }}</p>
      </div>
      {%- if section.settings.embed_url != blank -%}
        <div class="tkd-credibility__embed">
          <iframe
            src="{{ section.settings.embed_url }}"
            title="{{ section.settings.embed_title | escape }}"
            height="{{ section.settings.embed_height }}"
            width="100%"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          ></iframe>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Credibility",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "Heard on streams worldwide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Sounds from the TKD archive have already run on tracks with millions of plays. Production tested in the real world, ready for your next release."
    },
    {
      "type": "text",
      "id": "embed_url",
      "label": "URL do embed (vazio = oculto)"
    },
    {
      "type": "text",
      "id": "embed_title",
      "label": "Título acessível do embed",
      "default": "Playlist"
    },
    {
      "type": "range",
      "id": "embed_height",
      "label": "Altura do embed",
      "min": 80,
      "max": 400,
      "step": 4,
      "default": 152,
      "unit": "px"
    }
  ]
}
{% endschema %}
