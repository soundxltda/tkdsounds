{% comment %}
  TKD Latest Releases — grade de packs recentes (design system v2).
  Coleção via picker; cabeçalho com eyebrow, título e "view all".
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-latest {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-latest {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
  assign limit = section.settings.products_to_show
  assign view_all_url = col.url | default: routes.all_products_collection_url
-%}

<div class="tkd-latest tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w1300">
    <div class="tkd-listing-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="tkd-eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        <h2 class="tkd-h2">{{ section.settings.title | escape }}</h2>
      </div>
      {%- if section.settings.show_view_all -%}
        <a href="{{ view_all_url }}" class="tkd-listing-head__viewall">{{ section.settings.view_all_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if col.products.size > 0 -%}
      <div class="tkd-grid-packs">
        {%- for product in col.products limit: limit -%}
          <div class="tkd-grid-packs__item reveal" style="transition-delay: {{ forloop.index0 | times: 60 }}ms;">
            {% render 'tkd-pack-card', card_product: product %}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.bottom_button_label != blank -%}
        <div class="tkd-listing-more reveal">
          <a href="{{ view_all_url }}" class="tkd-btn tkd-btn-outline">{{ section.settings.bottom_button_label | escape }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="tkd-empty-note">Nenhum produto nessa coleção ainda.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TKD Latest Releases",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "Recent drops"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Latest releases"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção",
      "info": "Se vazia, usa todos os produtos."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Quantidade de packs",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar link \"view all\" no topo",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto do link \"view all\"",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "bottom_button_label",
      "label": "Botão inferior (vazio = oculto)",
      "default": "View all packs"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 96,
      "unit": "px"
    }
  ],
  "presets": [{ "name": "TKD Latest Releases" }]
}
{% endschema %}
