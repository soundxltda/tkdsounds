{% comment %}
  TKD Hero — "TKD Archives" (portado da seção HERO de routes/index.tsx).
  Linha de terminal, título gigante serif com aberração cromática,
  dois CTAs e o Featured Pack (product picker do Theme Editor).
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-hero {
    padding-top: {{ section.settings.padding_top | times: 0.66 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-hero {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="tkd-hero tkd-hero--centered tkd-section tkd-section--wide-gutters">
  <div class="tkd-section__inner tkd-section__inner--w900">
    {%- if section.settings.terminal_text != blank -%}
      <div class="tkd-hero__terminal tkd-hero__terminal--center reveal">{{ section.settings.terminal_text | escape }}</div>
    {%- endif -%}

    <h1 class="tkd-hero__title tkd-hero__title--center" data-tkd-stagger>{{ section.settings.title | escape }}</h1>

    <div class="tkd-hero__ctas tkd-hero__ctas--center reveal">
      {%- if section.settings.button1_label != blank -%}
        <a href="{{ section.settings.button1_link | default: routes.all_products_collection_url }}" class="tkd-btn tkd-btn-solid">
          {{- section.settings.button1_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
        <a href="{{ section.settings.button2_link }}" class="tkd-btn tkd-btn-outline">
          {{- section.settings.button2_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_scroll_cue -%}
      <div class="tkd-hero__scroll-wrap reveal">
        <button type="button" class="tkd-scroll-cue" data-tkd-scroll-cue aria-label="{{ section.settings.scroll_cue_text | escape }}">
          <span>{{ section.settings.scroll_cue_text | escape }}</span>
          <span class="tkd-scroll-cue__icon" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 4v16m0 0l-6-6m6 6l6-6" />
            </svg>
          </span>
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- # Esteira de kits: na abertura os cards sobem de baixo pra cima em
      # stagger e, assim que assentam, começam a deslizar de lado em loop
      # contínuo (pausa no hover). Inspirado na intro da Exo Audio. -%}
  {%- if section.settings.show_strip -%}
    {%- liquid
      assign strip_col = section.settings.strip_collection
      if strip_col == blank
        assign strip_col = collections.all
      endif
    -%}
    {%- if strip_col.products.size > 0 -%}
      <div class="tkd-hero__strip" data-tkd-hero-strip>
        <div class="tkd-marquee tkd-marquee--cards" data-tkd-marquee>
          <div
            class="tkd-marquee__track"
            style="--tkd-marquee-duration: {{ section.settings.strip_duration }}s; --tkd-marquee-card-w: 190px;"
          >
            {%- for product in strip_col.products limit: section.settings.strip_count -%}
              <div class="tkd-marquee__card">
                <a href="{{ product.url }}" class="tkd-strip-card">
                  <div class="tkd-strip-card__art">
                    {%- if product.featured_image -%}
                      {{
                        product.featured_image
                        | image_url: width: 570
                        | image_tag:
                          widths: '190,380,570',
                          sizes: '190px',
                          loading: 'eager',
                          alt: product.featured_image.alt
                      }}
                    {%- endif -%}
                  </div>
                  <div class="tkd-strip-card__name">{{ product.title | escape }}</div>
                  <div class="tkd-strip-card__price">
                    {%- if product.available -%}
                      {{ product.price | money_without_trailing_zeros }}
                    {%- else -%}
                      SOLD OUT
                    {%- endif -%}
                  </div>
                </a>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.featured_product != blank -%}
    <div class="tkd-section__inner tkd-section__inner--w720">
      <div class="tkd-hero__featured tkd-hero__featured--floating reveal">
        <div class="tkd-hero__featured-label">
          <span class="tkd-hero__star" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1L12 2z"/>
            </svg>
          </span>
          <span class="tkd-hero__featured-text">{{ section.settings.featured_label | escape }}</span>
        </div>
        {% render 'tkd-pack-card', card_product: section.settings.featured_product, lazy: false, layout: 'wide', custom_tagline: section.settings.featured_description %}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "TKD Hero",
  "tag": "section",
  "class": "section-tkd-hero",
  "settings": [
    {
      "type": "text",
      "id": "terminal_text",
      "label": "Linha de terminal",
      "default": "> LOADING ARCHIVE_INDEX.DAT ... OK"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "TKD Archives"
    },
    {
      "type": "header",
      "content": "Botões"
    },
    {
      "type": "text",
      "id": "button1_label",
      "label": "Botão principal — texto",
      "default": "▶ Browse Archive"
    },
    {
      "type": "url",
      "id": "button1_link",
      "label": "Botão principal — link",
      "info": "Se vazio, aponta para todos os produtos."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Botão secundário — texto",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Botão secundário — link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Mostrar indicador de scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_cue_text",
      "label": "Texto do indicador de scroll",
      "default": "Scroll"
    },
    {
      "type": "header",
      "content": "Esteira de kits"
    },
    {
      "type": "checkbox",
      "id": "show_strip",
      "label": "Mostrar esteira de kits",
      "info": "Os kits sobem de baixo pra cima na abertura e depois deslizam de lado em loop (pausa no hover).",
      "default": true
    },
    {
      "type": "collection",
      "id": "strip_collection",
      "label": "Coleção da esteira",
      "info": "Se vazia, usa todos os produtos da loja."
    },
    {
      "type": "range",
      "id": "strip_count",
      "label": "Kits na esteira",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "strip_duration",
      "label": "Duração de uma volta completa",
      "info": "Maior = mais lento.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    {
      "type": "header",
      "content": "Pack em destaque"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Rótulo",
      "default": "Featured Pack"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Produto em destaque"
    },
    {
      "type": "textarea",
      "id": "featured_description",
      "label": "Breve descrição do kit",
      "info": "Aparece embaixo do nome no card em destaque."
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço acima (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço abaixo (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "TKD Hero"
    }
  ]
}
{% endschema %}
