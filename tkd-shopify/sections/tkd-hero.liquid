{% comment %}
  TKD Hero — abertura da home (design system v2).
  Título display gigante com stagger de palavras, subtítulo, CTAs
  e indicador de scroll. Glow radial vem do CSS (.tkd-hero::before).
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-hero {
    padding-top: {{ section.settings.padding_top | times: 0.66 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-hero {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="tkd-hero tkd-section">
  <div class="tkd-hero__inner tkd-section__inner tkd-section__inner--w1200">
    {%- if section.settings.kicker != blank -%}
      <div class="tkd-eyebrow tkd-hero__kicker reveal">{{ section.settings.kicker | escape }}</div>
    {%- endif -%}

    <h1 class="tkd-hero__title" data-tkd-stagger data-accent-word="{{ section.settings.accent_word_index }}">
      {{- section.settings.title | escape -}}
    </h1>

    {%- if section.settings.subtitle != blank -%}
      <p class="tkd-hero__sub reveal">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    <div class="tkd-hero__ctas reveal">
      {%- if section.settings.button1_label != blank -%}
        <a href="{{ section.settings.button1_link | default: routes.all_products_collection_url }}" class="tkd-btn tkd-btn-solid">
          {{- section.settings.button1_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
        <a href="{{ section.settings.button2_link }}" class="tkd-btn tkd-btn-outline">
          {{- section.settings.button2_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_scroll_cue -%}
      <div class="tkd-hero__scroll-wrap reveal">
        <button type="button" class="tkd-scroll-cue" data-tkd-scroll-cue>
          <span>{{ section.settings.scroll_cue_text | escape }}</span>
          <span class="tkd-scroll-cue__icon" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 4v16m0 0l-6-6m6 6l6-6"/>
            </svg>
          </span>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TKD Hero",
  "tag": "section",
  "class": "section-tkd-hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Rótulo acima do título",
      "default": "Sample packs & sound kits"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Your next sound starts here"
    },
    {
      "type": "range",
      "id": "accent_word_index",
      "label": "Palavra destacada (posição, 0 = primeira)",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3,
      "info": "Pinta uma palavra do título com a cor de acento."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Drum kits, loops e one-shots prontos pra produção — direto do arquivo do TKD."
    },
    {
      "type": "header",
      "content": "Botões"
    },
    {
      "type": "text",
      "id": "button1_label",
      "label": "Botão principal — texto",
      "default": "Browse packs"
    },
    {
      "type": "url",
      "id": "button1_link",
      "label": "Botão principal — link",
      "info": "Se vazio, aponta para todos os produtos."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Botão secundário — texto",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Botão secundário — link"
    },
    {
      "type": "header",
      "content": "Indicador de scroll"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Mostrar indicador de scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_cue_text",
      "label": "Texto do indicador",
      "default": "Scroll"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 96,
      "unit": "px"
    }
  ],
  "presets": [{ "name": "TKD Hero" }]
}
{% endschema %}
