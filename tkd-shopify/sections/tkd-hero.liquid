{% comment %}
  TKD Hero — "TKD Archives" + cena grudada estilo Exo Audio.

  Em telas largas (e sem prefers-reduced-motion), Título/CTA e a
  esteira de "Featured Packs" viram 2 "atos" de uma cena com scroll
  travado (position: sticky): o título dá lugar à esteira — tudo
  dentro da mesma tela, como na abertura do site de referência. O
  controle fica em tkd-exo-motion.js (initHeroScene). Resto do site
  (grade de packs, FAQ, rodapé) continua com scroll comum — só a
  abertura usa esse efeito.

  Em mobile ou com movimento reduzido, os 2 blocos caem pro layout
  empilhado simples de sempre (sem sticky, sem scroll travado).
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-hero {
    padding-top: {{ section.settings.padding_top | times: 0.66 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-hero {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    /* Com a cena armada (título centralizado em 100vh), o padding
       acima só empurrava o título pra baixo do meio real da tela —
       a própria cena já centraliza o conteúdo dela sozinha. */
    #shopify-section-{{ section.id }} .tkd-hero:has(.tkd-scene.is-armed) {
      padding-top: 0;
    }
  }
{% endstyle %}

{%- liquid
  assign has_strip = false
  if section.settings.show_strip
    assign strip_col = section.settings.strip_collection
    if strip_col == blank
      assign strip_col = collections.all
    endif
    if strip_col.products.size > 0
      assign has_strip = true
    endif
  endif
  assign use_scene = section.settings.enable_scene
-%}

<div class="tkd-hero tkd-hero--centered tkd-section tkd-section--wide-gutters">
  <div
    class="tkd-scene{% unless use_scene %} tkd-scene--off{% endunless %}"
    data-tkd-scene
    {% unless use_scene %}data-tkd-scene-disabled{% endunless %}
  >
    <div class="tkd-scene__pin" data-tkd-scene-pin>

      {%- comment %} Ato 1 — título, terminal e CTAs {% endcomment -%}
      <div class="tkd-scene__layer tkd-scene__layer--title" data-tkd-scene-layer="title">
        <div class="tkd-section__inner tkd-section__inner--w900">
          {%- if section.settings.terminal_text != blank -%}
            <div class="tkd-hero__terminal tkd-hero__terminal--center reveal">{{ section.settings.terminal_text | escape }}</div>
          {%- endif -%}

          <h1 class="tkd-hero__title tkd-hero__title--center" data-tkd-stagger>{{ section.settings.title | escape }}</h1>

          <div class="tkd-hero__ctas tkd-hero__ctas--center reveal">
            {%- if section.settings.button1_label != blank -%}
              <a href="{{ section.settings.button1_link | default: routes.all_products_collection_url }}" class="tkd-btn tkd-btn-solid">
                {{- section.settings.button1_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
              <a href="{{ section.settings.button2_link }}" class="tkd-btn tkd-btn-outline">
                {{- section.settings.button2_label | escape -}}
              </a>
            {%- endif -%}
          </div>

          {%- if section.settings.show_scroll_cue -%}
            <div class="tkd-hero__scroll-wrap reveal">
              <button type="button" class="tkd-scroll-cue" data-tkd-scroll-cue aria-label="{{ section.settings.scroll_cue_text | escape }}">
                <span>{{ section.settings.scroll_cue_text | escape }}</span>
                <span class="tkd-scroll-cue__icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 4v16m0 0l-6-6m6 6l6-6" />
                  </svg>
                </span>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment %} Ato 2 — esteira de "Featured Packs" tomando a tela {% endcomment -%}
      {%- if has_strip -%}
        <div class="tkd-scene__layer tkd-scene__layer--kits" data-tkd-scene-layer="kits">
          <div class="tkd-hero__featured-label tkd-hero__featured-label--standalone reveal">
            <span class="tkd-hero__star" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1L12 2z"/>
              </svg>
            </span>
            <span class="tkd-hero__featured-text">{{ section.settings.featured_label | escape }}</span>
          </div>
          <div class="tkd-hero__strip" data-tkd-hero-strip>
            <div class="tkd-marquee tkd-marquee--cards" data-tkd-marquee>
              <div
                class="tkd-marquee__track"
                style="--tkd-marquee-duration: {{ section.settings.strip_duration }}s; --tkd-marquee-card-w: 190px;"
              >
                {%- for product in strip_col.products limit: section.settings.strip_count -%}
                  {%- liquid
                    assign strip_previews = product.metafields.tkd.preview_files.value
                    assign strip_titles = product.metafields.tkd.preview_titles.value
                    assign strip_psize = 0
                    if strip_previews
                      assign strip_psize = strip_previews.size
                    endif
                    assign strip_midx = product.metafields.tkd.master_preview_index.value | default: 0 | at_least: 0
                    if strip_midx >= strip_psize
                      assign strip_midx = 0
                    endif
                    assign strip_preview_url = ''
                    assign strip_preview_name = product.title
                    if strip_psize > 0
                      for strip_preview_file in strip_previews
                        if forloop.index0 == strip_midx
                          assign strip_preview_url = strip_preview_file.url
                        endif
                      endfor
                      for strip_preview_title in strip_titles
                        if forloop.index0 == strip_midx and strip_preview_title != blank
                          assign strip_preview_name = strip_preview_title
                        endif
                      endfor
                    endif
                    assign strip_accent = product.metafields.tkd.accent_color.value | default: '#5fb2e6'
                  -%}
                  <div class="tkd-marquee__card">
                    <a href="{{ product.url }}" class="tkd-strip-card">
                      <div class="tkd-strip-card__art">
                        {%- if product.featured_image -%}
                          {{
                            product.featured_image
                            | image_url: width: 570
                            | image_tag:
                              widths: '190,380,570',
                              sizes: '190px',
                              loading: 'eager',
                              alt: product.featured_image.alt
                          }}
                        {%- endif -%}
                        {%- if strip_preview_url != blank -%}
                          <div class="pack-tile__hover-layer">
                            <button
                              type="button"
                              class="audio-play-btn pack-tile__hover-play"
                              data-tkd-play
                              data-track-id="{{ product.id }}-preview"
                              data-track-src="{{ strip_preview_url }}"
                              data-track-name="{{ strip_preview_name | escape }}"
                              data-pack-name="{{ product.title | escape }}"
                              data-pack-url="{{ product.url }}"
                              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                              data-accent="{{ strip_accent }}"
                              {% if product.featured_image %}data-cover="{{ product.featured_image | image_url: width: 144 }}"{% endif %}
                              aria-label="Play {{ product.title | escape }}"
                            >
                              <svg class="tkd-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                              <svg class="tkd-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
                            </button>
                          </div>
                        {%- endif -%}
                      </div>
                      <div class="tkd-strip-card__name">{{ product.title | escape }}</div>
                      <div class="tkd-strip-card__price">
                        {%- if product.available -%}
                          {{ product.price | money_without_trailing_zeros }}
                        {%- else -%}
                          SOLD OUT
                        {%- endif -%}
                      </div>
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Hero",
  "tag": "section",
  "class": "section-tkd-hero",
  "settings": [
    {
      "type": "text",
      "id": "terminal_text",
      "label": "Linha de terminal (vazio = oculto)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "TKD Archives"
    },
    {
      "type": "header",
      "content": "Botões"
    },
    {
      "type": "text",
      "id": "button1_label",
      "label": "Botão principal — texto",
      "default": "▶ Browse Archive"
    },
    {
      "type": "url",
      "id": "button1_link",
      "label": "Botão principal — link",
      "info": "Se vazio, aponta para todos os produtos."
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Botão secundário — texto",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Botão secundário — link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Mostrar indicador de scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_cue_text",
      "label": "Texto do indicador de scroll",
      "default": "Scroll"
    },
    {
      "type": "header",
      "content": "Cena de abertura (estilo Exo Audio)"
    },
    {
      "type": "checkbox",
      "id": "enable_scene",
      "label": "Ativar cena com scroll travado",
      "info": "Título e a esteira de Featured Packs viram 2 atos de uma cena: você rola e cada um toma a tela por vez. Desliga sozinho em celular e com \"reduzir movimento\" ativado. Se desmarcado, os 2 blocos ficam empilhados normalmente.",
      "default": true
    },
    {
      "type": "header",
      "content": "Esteira de Featured Packs"
    },
    {
      "type": "checkbox",
      "id": "show_strip",
      "label": "Mostrar esteira",
      "info": "Segundo ato da cena de abertura: toma a tela depois do título e desliza de lado em loop (pausa no hover).",
      "default": true
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Rótulo",
      "default": "Featured Packs"
    },
    {
      "type": "collection",
      "id": "strip_collection",
      "label": "Coleção da esteira",
      "info": "Se vazia, usa todos os produtos da loja."
    },
    {
      "type": "range",
      "id": "strip_count",
      "label": "Kits na esteira",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "strip_duration",
      "label": "Duração de uma volta completa",
      "info": "Maior = mais lento.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço acima (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço abaixo (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "TKD Hero"
    }
  ]
}
{% endschema %}
