{% comment %}
  TKD Landing — Pricing. "Value stack" (blocks com item + valor), total
  vs preço real do produto (nativo, nunca hardcoded), contador de
  urgência opcional e CTA via product form. Reutilizável.
{% endcomment %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign total_value_cents = 0
  for block in section.blocks
    if block.type == 'line_item'
      assign total_value_cents = total_value_cents | plus: block.settings.value
    endif
  endfor
-%}

<div class="tkd-landing-pricing tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w720">
    <div class="win tkd-landing-pricing__win">
      <div class="win-title">
        <span>{{ section.settings.window_title | escape }}</span>
        <span class="win-controls"><span>_</span><span>&#9633;</span><span>&times;</span></span>
      </div>
      <div class="tkd-landing-pricing__pad">
        {%- if section.settings.show_countdown and section.settings.countdown_end != blank -%}
          <div class="tkd-landing-countdown" data-tkd-countdown data-end="{{ section.settings.countdown_end }}">
            {%- if section.settings.countdown_label != blank -%}
              <span class="tkd-landing-countdown__label">{{ section.settings.countdown_label | escape }}</span>
            {%- endif -%}
            <span class="tkd-landing-countdown__clock font-tkd-pixel">
              <span data-tkd-countdown-d>00</span>d
              <span data-tkd-countdown-h>00</span>h
              <span data-tkd-countdown-m>00</span>m
              <span data-tkd-countdown-s>00</span>s
            </span>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <dl class="tkd-proplist tkd-landing-pricing__stack">
            {%- for block in section.blocks -%}
              {%- if block.type == 'line_item' -%}
                <div class="tkd-proplist__row" {{ block.shopify_attributes }}>
                  <dt>{{ block.settings.label | escape }}</dt>
                  <dd>{{ block.settings.value | times: 1.0 | divided_by: 100.0 | money_without_trailing_zeros }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
            {%- if total_value_cents > 0 -%}
              <div class="tkd-proplist__row tkd-landing-pricing__total-row">
                <dt>{{ section.settings.total_label | escape }}</dt>
                <dd>{{ total_value_cents | times: 1.0 | divided_by: 100.0 | money_without_trailing_zeros }}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}

        <div class="tkd-price-row tkd-price-row--center font-tkd-pixel">
          <span class="tkd-landing-pricing__pay-label">{{ section.settings.pay_label | escape }}</span>
          <span class="tkd-price-row__price tkd-price-row__price--lg">{{ product.price | money_without_trailing_zeros }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="tkd-price-row__was">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
          {%- endif -%}
        </div>

        <div class="tkd-product-cta__action">
          <product-form data-section-id="{{ section.id }}" data-hide-errors="false">
            {%- form 'product', product, id: 'tkd-landing-form-pricing', class: 'tkd-product-form tkd-product-form--center', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                name="add"
                class="tkd-btn tkd-btn-solid tkd-buy-btn tkd-buy-btn--wide"
                {% unless product.available %}disabled aria-disabled="true"{% endunless %}
              >
                <span>
                  {%- if product.available -%}
                    {{ section.settings.cta_label | escape }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                {%- render 'loading-spinner' -%}
              </button>
              <div class="product-form__error-message-wrapper tkd-form-error" role="alert" hidden>
                <span class="product-form__error-message"></span>
              </div>
            {%- endform -%}
          </product-form>
        </div>

        {%- if section.settings.urgency_text != blank -%}
          <p class="tkd-landing-pricing__urgency">{{ section.settings.urgency_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Landing — Pricing",
  "tag": "section",
  "class": "section-tkd-landing-pricing",
  "settings": [
    {
      "type": "text",
      "id": "window_title",
      "label": "Título da janela",
      "default": "PRICING"
    },
    {
      "type": "text",
      "id": "pay_label",
      "label": "Rótulo do preço",
      "default": "WHAT YOU PAY"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Rótulo do valor total",
      "default": "TOTAL VALUE"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do botão",
      "default": "START CREATING NOW!"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Texto de urgência (abaixo do botão)"
    },
    {
      "type": "header",
      "content": "Contador de urgência (opcional)"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Mostrar contador",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Texto antes do contador",
      "default": "You have"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Data/hora final (ISO, ex.: 2026-08-15T23:59:00Z)",
      "info": "Formato ISO 8601 em UTC. O contador some automaticamente após essa data."
    }
  ],
  "blocks": [
    {
      "type": "line_item",
      "name": "Item de valor",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo",
          "default": "SAMPLE PACK (WITH STEMS)"
        },
        {
          "type": "number",
          "id": "value",
          "label": "Valor (em centavos, ex.: 5000 = $50.00)",
          "default": 5000
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "TKD Landing — Pricing",
      "blocks": [{ "type": "line_item" }, { "type": "line_item" }, { "type": "line_item" }]
    }
  ]
}
{% endschema %}
