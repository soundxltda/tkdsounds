{% comment %}
  TKD 404 — página não encontrada: número gigante em outline,
  mensagem e botão de volta (design system v2).
{% endcomment %}

<div class="tkd-404 tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w900">
    <div class="tkd-404__code" aria-hidden="true">404</div>
    <h1 class="tkd-404__title">{{ section.settings.title | escape }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="tkd-404__sub">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    <div class="tkd-404__action">
      <a href="{{ section.settings.button_link | default: routes.root_url }}" class="tkd-btn tkd-btn-solid">
        {{- section.settings.button_label | escape -}}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD 404",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "This page doesn't exist"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "O link pode ter mudado — mas os sons continuam no lugar."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Back to home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão",
      "info": "Se vazio, aponta para a home."
    }
  ]
}
{% endschema %}
