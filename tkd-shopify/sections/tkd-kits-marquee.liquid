{% comment %}
  TKD Kits em Movimento — fileira de pack cards deslizando na
  horizontal em loop contínuo (estilo "Recent Drops" da Exo Audio).
  Pausa quando o mouse passa por cima; direção e velocidade
  configuráveis. A JS (tkd-exo-motion.js) duplica os cards até
  cobrir a tela, então funciona mesmo com poucos produtos.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .tkd-kits-marquee {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tkd-kits-marquee {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
  assign limit = section.settings.products_to_show
-%}

<div class="tkd-kits-marquee tkd-section tkd-section--wide-gutters">
  {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
    <div class="tkd-section__inner tkd-section__inner--w1200">
      <div class="tkd-kits-marquee__head reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <div class="tkd-eyebrow text-amber">{{ section.settings.eyebrow | escape }}</div>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="tkd-kits-marquee__title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <a href="{{ col.url }}" class="tkd-kits-marquee__viewall">{{ section.settings.view_all_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if col.products.size == 0 -%}
    <div class="tkd-section__inner tkd-section__inner--w1200">
      <div class="tkd-empty-note">&gt; No packs published yet.</div>
    </div>
  {%- else -%}
    <div
      class="tkd-marquee tkd-marquee--cards{% if section.settings.direction == 'right' %} tkd-marquee--reverse{% endif %} reveal"
      data-tkd-marquee
    >
      <div
        class="tkd-marquee__track"
        style="--tkd-marquee-duration: {{ section.settings.duration }}s; --tkd-marquee-card-w: {{ section.settings.card_width }}px;"
      >
        {%- for product in col.products limit: limit -%}
          <div class="tkd-marquee__card">
            {% render 'tkd-pack-card', card_product: product %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "TKD Kits em Movimento",
  "tag": "section",
  "class": "section-tkd-kits-marquee",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "\/\/ FULL ARCHIVE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Browse the vault"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção",
      "info": "Se vazia, usa todos os produtos da loja."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Packs na esteira",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direção do movimento",
      "options": [
        { "value": "left", "label": "Da direita pra esquerda" },
        { "value": "right", "label": "Da esquerda pra direita" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Duração de uma volta completa",
      "info": "Maior = mais lento. A esteira pausa quando o mouse passa por cima.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 55
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Largura dos cards",
      "min": 200,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "header",
      "content": "Ver todos"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar link \"ver todos\"",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto do link",
      "default": "[VIEW ALL →]"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço acima (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço abaixo (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "TKD Kits em Movimento"
    }
  ]
}
{% endschema %}
