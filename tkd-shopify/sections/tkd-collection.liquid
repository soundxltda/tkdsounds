{% comment %}
  TKD Collection — listagem de packs com título gigante, contagem e
  paginação em pills (design system v2).
{% endcomment %}

<div class="tkd-collection tkd-section">
  <div class="tkd-section__inner tkd-section__inner--w1300">
    <div class="tkd-collection__head reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="tkd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h1 class="tkd-collection__title">
        {%- if section.settings.title_override != blank -%}
          {{ section.settings.title_override | escape }}
        {%- else -%}
          {{ collection.title | escape }}
        {%- endif -%}
      </h1>
      <p class="tkd-collection__count">{{ collection.products_count }} pack{% if collection.products_count != 1 %}s{% endif %} disponíve{% if collection.products_count != 1 %}is{% else %}l{% endif %}</p>
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="tkd-grid-packs">
          {%- for product in collection.products -%}
            <div class="tkd-grid-packs__item reveal" style="transition-delay: {{ forloop.index0 | modulo: 3 | times: 60 }}ms;">
              {% render 'tkd-pack-card', card_product: product %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="tkd-pagination" role="navigation" aria-label="Paginação">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Página anterior">&larr;</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="current" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Próxima página">&rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="tkd-empty-note">{{ 'sections.collection_template.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "TKD Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "The archive"
    },
    {
      "type": "text",
      "id": "title_override",
      "label": "Título (vazio = nome da coleção)"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Packs por página",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ]
}
{% endschema %}
