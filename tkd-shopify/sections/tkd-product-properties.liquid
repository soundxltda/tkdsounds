{% comment %}
  TKD Product Properties — especificações do pack (metafields tkd.*)
  em tabela de linhas alternadas + descrição do produto.
{% endcomment %}

{%- liquid
  assign m = product.metafields.tkd
-%}

<div class="tkd-product-properties tkd-section">
  <div class="tkd-card tkd-product-properties__pad tkd-section__inner tkd-section__inner--w1300">
    <div class="tkd-product-properties__inner">
      <div class="tkd-product-properties__head reveal">
        {%- if section.settings.eyebrow != blank -%}
          <div class="tkd-eyebrow tkd-product-properties__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="tkd-h2">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>

      {%- comment -%}
        Checklist no lugar da tabela técnica: a ficha longa (BPM, tom, tamanho)
        continua existindo logo abaixo pra quem quer o detalhe, mas o que vende
        vem primeiro e em linha varrível. A linha de stems só aparece na edição
        que os inclui — o JS liga/desliga junto com o seletor.
      {%- endcomment -%}
      <ul class="tkd-included reveal">
        {%- if m.composition_count.value -%}
          <li class="tkd-included__item">{{ m.composition_count.value }} original compositions</li>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="tkd-included__item"{% if block.settings.stems_only %} data-tkd-stems-only hidden{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_specs -%}
      <dl class="tkd-proplist tkd-proplist--compact reveal">
        {%- if m.sample_count.value -%}
          <div class="tkd-proplist__row"><dt>Samples</dt><dd>{{ m.sample_count.value }}</dd></div>
        {%- endif -%}
        {%- if m.one_shot_count.value -%}
          <div class="tkd-proplist__row"><dt>One-shots</dt><dd>{{ m.one_shot_count.value }}</dd></div>
        {%- endif -%}
        {%- if m.bpm_range.value != blank -%}
          <div class="tkd-proplist__row"><dt>BPM range</dt><dd>{{ m.bpm_range.value | escape }}</dd></div>
        {%- endif -%}
        {%- if m.key_info.value != blank -%}
          <div class="tkd-proplist__row"><dt>Key</dt><dd>{{ m.key_info.value | escape }}</dd></div>
        {%- endif -%}
        {%- if m.file_size.value != blank -%}
          <div class="tkd-proplist__row"><dt>Download size</dt><dd>{{ m.file_size.value | escape }}</dd></div>
        {%- endif -%}
        {%- if m.source_note.value != blank -%}
          <div class="tkd-proplist__row tkd-proplist__row--top"><dt>Source</dt><dd class="tkd-proplist__dd-wide">{{ m.source_note.value | escape }}</dd></div>
        {%- endif -%}
        {%- if m.contents_summary.value != blank -%}
          <div class="tkd-proplist__row tkd-proplist__row--top"><dt>Contents</dt><dd class="tkd-proplist__dd-wide">{{ m.contents_summary.value | escape | newline_to_br }}</dd></div>
        {%- endif -%}
        {%- if product.tags.size > 0 and section.settings.show_tags -%}
          <div class="tkd-proplist__row tkd-proplist__row--top"><dt>Tags</dt><dd class="tkd-proplist__dd-wide">{{ product.tags | join: ', ' }}</dd></div>
        {%- endif -%}
      </dl>
      {%- endif -%}

      {%- if section.settings.show_description and product.description != blank -%}
        <div class="tkd-product-description reveal">{{ product.description }}</div>
      {%- endif -%}

      {%- if m.credits.value != blank -%}
        <div class="tkd-product-description reveal">
          <strong>Credits</strong>
          <p>{{ m.credits.value | escape | newline_to_br }}</p>
        </div>
      {%- endif -%}

      {%- if m.download_instructions.value != blank -%}
        <div class="tkd-product-description reveal">
          <strong>{{ section.settings.download_title | escape }}</strong>
          <p>{{ m.download_instructions.value | escape | newline_to_br }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TKD Product Properties",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rótulo",
      "default": "What's inside"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "What's included"
    },
    {
      "type": "text",
      "id": "royalty_text",
      "label": "Linha de licença",
      "default": "100% royalty-free"
    },
    {
      "type": "text",
      "id": "sound_source_text",
      "label": "Linha de origem do som",
      "info": "Ex.: \"100% analog\". Vazio = oculta a linha.",
      "default": "100% analog"
    },
    {
      "type": "checkbox",
      "id": "show_specs",
      "label": "Mostrar ficha técnica detalhada",
      "info": "Tabela de BPM, tom, tamanho etc. abaixo da checklist.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Mostrar tags do produto",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descrição do produto",
      "default": true
    },
    {
      "type": "text",
      "id": "download_title",
      "label": "Título das instruções de download",
      "default": "How to download"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item da checklist",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "WAV 24-bit" },
        {
          "type": "checkbox",
          "id": "stems_only",
          "label": "Só na edição com stems",
          "info": "Aparece apenas quando o visitante escolhe a edição que inclui stems.",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
