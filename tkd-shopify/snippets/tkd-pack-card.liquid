{% comment %}
  TKD Pack Card — card de sample pack (design system v2).
  Uso:
    {% render 'tkd-pack-card', card_product: product %}
    {% render 'tkd-pack-card', card_product: product, lazy: false %}
    {% render 'tkd-pack-card', card_product: product, layout: 'wide' %}   <- destaque
  O botão de play usa o contrato data-* de assets/tkd-player.js.
{% endcomment %}

{%- liquid
  assign previews = card_product.metafields.tkd.preview_files.value
  assign titles = card_product.metafields.tkd.preview_titles.value
  assign genre = card_product.metafields.tkd.genre.value
  assign formats = card_product.metafields.tkd.formats.value
  assign tagline = card_product.metafields.tkd.tagline.value

  assign psize = 0
  if previews
    assign psize = previews.size
  endif

  assign midx = card_product.metafields.tkd.master_preview_index.value | default: 0 | at_least: 0
  if midx >= psize
    assign midx = 0
  endif

  assign preview_url = ''
  assign preview_name = card_product.title
  if psize > 0
    assign preview_file = previews[midx]
    assign preview_url = preview_file.url
    if titles and titles[midx] != blank
      assign preview_name = titles[midx]
    endif
  endif

  if lazy == false
    assign img_loading = 'eager'
  else
    assign img_loading = 'lazy'
  endif

  assign badge_text = ''
  assign badge_class = 'tkd-badge'
  for tag in card_product.tags
    assign tag_down = tag | downcase
    if tag_down == 'bestseller'
      assign badge_text = 'Bestseller'
      break
    elsif tag_down == 'new' or tag_down == 'novo'
      assign badge_text = 'New'
      assign badge_class = 'tkd-badge tkd-badge--ghost'
    elsif tag_down == 'free' or tag_down == 'gratis' or tag_down == 'grátis'
      assign badge_text = 'Free'
      assign badge_class = 'tkd-badge tkd-badge--lime'
    endif
  endfor

  assign is_wide = false
  if layout == 'wide'
    assign is_wide = true
  endif
-%}

<div class="pack-card{% if is_wide %} pack-card--wide{% endif %}">
  <a href="{{ card_product.url }}" class="pack-card__art" aria-label="{{ card_product.title | escape }}" tabindex="-1">
    {%- if card_product.featured_image -%}
      <img
        src="{{ card_product.featured_image | image_url: width: 720 }}"
        srcset="{{ card_product.featured_image | image_url: width: 360 }} 360w, {{ card_product.featured_image | image_url: width: 540 }} 540w, {{ card_product.featured_image | image_url: width: 720 }} 720w"
        sizes="(min-width: 990px) 30vw, 50vw"
        width="{{ card_product.featured_image.width }}"
        height="{{ card_product.featured_image.height }}"
        alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
        loading="{{ img_loading }}"
      >
    {%- else -%}
      <div class="pack-card__fallback"><span>{{ card_product.title | escape }}</span></div>
    {%- endif -%}
  </a>

  {%- if badge_text != blank -%}
    <span class="pack-card__badge {{ badge_class }}">{{ badge_text }}</span>
  {%- endif -%}

  {%- if preview_url != blank -%}
    <div class="pack-card__play">
      <button
        type="button"
        class="audio-play-btn"
        data-tkd-play
        data-track-id="{{ card_product.id }}-{{ midx }}"
        data-track-src="{{ preview_url }}"
        data-track-name="{{ preview_name | escape }}"
        data-pack-name="{{ card_product.title | escape }}"
        data-pack-url="{{ card_product.url }}"
        {% if card_product.featured_image %}data-cover="{{ card_product.featured_image | image_url: width: 120 }}"{% endif %}
        aria-label="Play preview — {{ card_product.title | escape }}"
      >
        <svg class="tkd-icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        <svg class="tkd-icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
      </button>
    </div>
  {%- endif -%}

  <div class="pack-card__body">
    {%- if genre != blank or formats != blank -%}
      <div class="pack-card__meta">
        {%- if genre != blank -%}<span class="genre">{{ genre | escape }}</span>{%- endif -%}
        {%- if formats != blank -%}<span>{{ formats | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    <h3 class="pack-card__name">
      <a href="{{ card_product.url }}" style="color: inherit; text-decoration: none;">{{ card_product.title | escape }}</a>
    </h3>

    {%- if tagline != blank -%}
      <div class="pack-card__tagline">{{ tagline | escape }}</div>
    {%- endif -%}

    {%- if is_wide -%}
      {%- liquid
        assign sample_count = card_product.metafields.tkd.sample_count.value
        assign one_shot_count = card_product.metafields.tkd.one_shot_count.value
        assign bpm_range = card_product.metafields.tkd.bpm_range.value
        assign includes_midi = card_product.metafields.tkd.includes_midi.value
        assign includes_stems = card_product.metafields.tkd.includes_stems.value
        assign file_size = card_product.metafields.tkd.file_size.value
      -%}
      {%- if sample_count or one_shot_count or bpm_range or includes_midi or includes_stems or file_size -%}
        <ul class="pack-card__features">
          {%- if sample_count -%}<li>{{ sample_count }} samples</li>{%- endif -%}
          {%- if one_shot_count -%}<li>{{ one_shot_count }} one-shots</li>{%- endif -%}
          {%- if bpm_range != blank -%}<li>{{ bpm_range | escape }} BPM</li>{%- endif -%}
          {%- if includes_midi -%}<li>MIDI incluído</li>{%- endif -%}
          {%- if includes_stems -%}<li>Stems incluídos</li>{%- endif -%}
          {%- if file_size != blank -%}<li>{{ file_size | escape }}</li>{%- endif -%}
        </ul>
      {%- endif -%}

      <div class="pack-card__price-row">
        <div>
          <span class="pack-card__price">{{ card_product.price | money }}</span>
          {%- if card_product.compare_at_price > card_product.price -%}
            <span class="pack-card__was">{{ card_product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
      </div>
      <div class="pack-card__actions">
        <a href="{{ card_product.url }}" class="tkd-btn tkd-btn-solid tkd-btn--sm">Ver pack</a>
        {%- if preview_url != blank -%}
          <button
            type="button"
            class="tkd-btn tkd-btn-outline tkd-btn--sm"
            data-tkd-play
            data-track-id="{{ card_product.id }}-{{ midx }}"
            data-track-src="{{ preview_url }}"
            data-track-name="{{ preview_name | escape }}"
            data-pack-name="{{ card_product.title | escape }}"
            data-pack-url="{{ card_product.url }}"
            {% if card_product.featured_image %}data-cover="{{ card_product.featured_image | image_url: width: 120 }}"{% endif %}
          >
            Ouvir preview
          </button>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="pack-card__price-row">
        <div>
          <span class="pack-card__price">{{ card_product.price | money }}</span>
          {%- if card_product.compare_at_price > card_product.price -%}
            <span class="pack-card__was">{{ card_product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        <a href="{{ card_product.url }}" class="pack-card__cta">Ver pack
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14m0 0l-6-6m6 6l-6 6"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
