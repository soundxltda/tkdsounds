{% comment %}
  TKD Marquee — faixa horizontal em loop contínuo (CSS puro).
  Uso: {% render 'tkd-marquee', blocks: section.blocks, duration: 30 %}
  Cada block precisa de settings.text; o conteúdo é duplicado para
  o loop de translateX(-50%) fechar sem emenda.
{% endcomment %}

{%- liquid
  assign speed = duration | default: 30
-%}

<div class="tkd-marquee-strip" style="--tkd-marquee-duration: {{ speed }}s;" aria-hidden="true">
  <div class="tkd-marquee-track">
    {%- for i in (1..2) -%}
      {%- for block in blocks -%}
        {%- if block.settings.text != blank -%}
          <span class="tkd-marquee-item">
            {{ block.settings.text | escape }}
            <span class="sep">✦</span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
